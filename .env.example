DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_guild_id_here

# Role IDs for event type mentions
ROLE_ID_FRACTALS=your_fractals_role_id
ROLE_ID_RAIDS=your_raids_role_id
ROLE_ID_CONTENT=your_content_role_id

# Custom emoji strings (format: <:name:id>)
# To get emoji IDs: type \:emoji_name: in Discord, or right-click emoji → Copy Link
EMOJI_ANY=<:flex:your_emoji_id>
EMOJI_DPS=<:dps:your_emoji_id>
EMOJI_BOON_DPS=<:boondps:your_emoji_id>
EMOJI_HEALER=<:heal:your_emoji_id>
EMOJI_TANK=<:tank:your_emoji_id>
EMOJI_KITE=<:special:your_emoji_id>
EMOJI_GLUT=<:special:your_emoji_id>
EMOJI_SPECIAL=<:special:your_emoji_id>
EMOJI_DEFAULT=<:special:your_emoji_id>
